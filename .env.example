# Copie ce fichier en .env.local (dev) et configure les mêmes variables
# dans les "Environment Variables" de ton hébergeur (Vercel / Netlify) pour la prod.

# --- Authentification de l'Atelier (espace admin) ---
# Génère ces deux valeurs avec : npm run hash-password
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_HASH=

# Chaîne aléatoire longue (32+ caractères) utilisée pour signer les sessions.
# Génère-en une avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Publication du contenu modifié (Atelier -> site public) ---
# En production (Vercel/Netlify), le disque n'est pas persistant : chaque
# enregistrement depuis l'Atelier crée donc un commit Git sur ce dépôt via
# l'API GitHub, ce qui déclenche un redéploiement automatique.
# Crée un "fine-grained personal access token" GitHub avec la permission
# "Contents: Read and write" sur CE dépôt uniquement.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main
GITHUB_CONTENT_PATH=data/content.json

# Si GITHUB_TOKEN n'est pas défini (typiquement en local avec `npm run dev`),
# l'Atelier écrit directement dans data/content.json sur le disque local
# pour un cycle de développement plus rapide.

# --- Stockage des images uploadées depuis l'Atelier ---
# Sur Vercel : Storage -> Create Database -> Blob, puis connecte-le au
# projet. Vercel ajoute automatiquement BLOB_READ_WRITE_TOKEN, rien à
# copier ici. Sans cette variable (typiquement en local), l'upload écrit
# directement dans public/uploads sur le disque local.
BLOB_READ_WRITE_TOKEN=
